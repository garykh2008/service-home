home.garyhsieh-proj.com {
	# 登入保護（basic_auth）。密碼 hash 從環境變數 HOME_AUTH_HASH 帶入，不進版控。
	# 設定方式見 README「home 頁面登入」。
	basic_auth {
		gary {$HOME_AUTH_HASH}
	}

	# Uptime Kuma 狀態頁 API 同源代理，給 custom.js 讀（避免跨網域 CORS）。
	# /kuma/api/status-page/... → uptime-kuma /api/status-page/...
	handle_path /kuma/* {
		reverse_proxy 127.0.0.1:3051
	}

	handle {
		reverse_proxy 127.0.0.1:3050
	}
}
